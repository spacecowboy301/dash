DATABASE_URL=postgres://localhost:5432/personal_os

# Both values are required for paid model evaluation. It is off by default.
ENABLE_OPENAI_EVALUATION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Application-enforced monthly ceiling, in US microdollars.
OPENAI_MONTHLY_BUDGET_MICRO_USD=5000000

# Price assumptions used by the local ledger. Verify when changing models.
OPENAI_INPUT_MICRO_USD_PER_MILLION_TOKENS=1000000
OPENAI_OUTPUT_MICRO_USD_PER_MILLION_TOKENS=6000000
